    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
    <!-- Self-host clone-and-run: PrivateAssets="all" made this a
         development-dependency, so `dotnet publish` EXCLUDED the assembly while plain builds
         copied it; Startup calls AddDatabaseDeveloperPageExceptionFilter() unconditionally, so
         every PUBLISHED portal (i.e. every container) crashed at boot with
         FileNotFoundException while local bin/ runs worked. The filter only activates alongside
         the Development-environment exception page, so shipping it is standard (template default). -->
