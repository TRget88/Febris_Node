  <ItemGroup>
    <Compile Remove="Templates\**" />
    <Content Remove="Templates\**" />
    <EmbeddedResource Remove="Templates\**" />
    <None Remove="Templates\**" />
    <!-- NET8 Wave 4: quarantine the stock ASP.NET-template Identity migration (the
         00000000000000_ placeholder timestamp is the scaffold artifact). It describes a
         SQL SERVER schema (SqlServerValueGenerationStrategy) that was never applied to
         Febris's Postgres DBs. The real Identity schema is EndUserDAL's ApplicationDb
         migrations (Npgsql). It only compiled on 3.1 because the vestigial SqlServer
         provider package (now dropped) happened to be referenced, and it was inert at
         runtime (the DAL, not this portal, is the context's migrations assembly).
         Files kept on disk per the repo's quarantine-don't-delete convention. -->
    <Compile Remove="Data\Migrations\00000000000000_CreateIdentitySchema.cs" />
    <Compile Remove="Data\Migrations\00000000000000_CreateIdentitySchema.Designer.cs" />
  </ItemGroup>

