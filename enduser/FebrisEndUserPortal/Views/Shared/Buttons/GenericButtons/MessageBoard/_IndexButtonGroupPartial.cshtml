@model Febris.ModelLibrary.PartialViewModels.IndividualButtonPartial
@using Febris.ModelLibrary.PartialViewModels;


<td style="width:50px;">
    <div class="btn-group" role="group">
        @await Html.PartialAsync("Buttons/_IndividualButtonPartial",
             new IndividualButtonPartial
             {
                 Action = "MessageboardDetails",
                 ButtonType = "btn-info",
                 Glyph = "info-circle",
                 Id = Model.Id,
                 Tooltip = "Details about this message board post"
             })
    </div>
</td>


