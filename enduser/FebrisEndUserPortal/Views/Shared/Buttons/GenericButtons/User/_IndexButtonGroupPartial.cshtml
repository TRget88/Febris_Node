@model Febris.ModelLibrary.PartialViewModels.IndividualUUIDButtonPartial
@using Febris.ModelLibrary.PartialViewModels;


<td style="width:50px;">
    <div class="btn-group" role="group">
        @await Html.PartialAsync("Buttons/_IndividualUUIDButtonPartial",
             new IndividualUUIDButtonPartial
             {
                 Action = "UserDetails",
                 ButtonType = "btn-info",
                 Glyph = "info-circle",
                 Id = Model.Id,
                 Tooltip = "Details about this user"
             })
    </div>
</td>


