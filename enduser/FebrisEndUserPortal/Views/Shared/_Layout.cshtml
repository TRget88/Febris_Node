                            <img alt="Febris logo" class="img-fluid" style="height:30px; width:30px" src="~/images/Logo/FebrisIcon_White.png" />
                            <span>
                                <img src="~/images/Logo/Febris_white_gimp.png" alt="Febris logo" class="img-fluid" style="width:130px" />
                            </span>
                        </a>
                    </div>

                    <div class="clearfix"></div>

                    @if (User != null)
                    {
                        <!-- menu profile quick info -->
                        <div class="profile clearfix">
                            <div class="profile_pic">

                                @if (User.HasProfilePicture() != null)
                                {
                                    @if (User.HasProfilePicture())
                                    {
                                        <a asp-controller="User" asp-action="SelfEdit">
                                            <img id="NavBarPicture" src="@Url.Action("LoadProfilePicture", "Widget", new { path = User.ProfilePicturePath() })" alt="Profile picture" class="img-circle profile_img">
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="User" asp-action="SelfEdit">
                                            <img id="NavBarPicture" src="~/images/DefaultMedia/DefaultPerson.png" alt="Default Picture" class="img-circle profile_img">
                                        </a>
                                    }
                                }
                                else
                                {
                                    <a asp-controller="User" asp-action="SelfEdit">
                                        <img id="NavBarPicture" src="~/images/DefaultMedia/DefaultPerson.png" alt="Default Picture" class="img-circle profile_img">
                                    </a>
                                }
                            </div>
                            <div class="profile_info">
                                <span>Welcome,</span>
                                <h2>
                                    @if (!string.IsNullOrEmpty(User.LastName()) || !string.IsNullOrEmpty(User.FirstName()))
                                    {
                                        @if (!string.IsNullOrEmpty(User.LastName()))
                                        {
                                            @User.FirstName();
                                        }
                                        <br />
                                        @if (!string.IsNullOrEmpty(User.FirstName()))
                                        {
                                            @User.LastName()
                                        }
                                    }
                                    else
                                    {
                                        @User.Identity.Name.Replace('_', ' ')
                                    }
                                </h2>
                            </div>
                            <div class="clearfix"></div>
                        </div>
                        <!-- /menu profile quick info -->
                    }


