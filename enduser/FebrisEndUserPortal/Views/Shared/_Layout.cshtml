                    <!-- Modal content -->
                    <div class="modal-content">
                        <span class="close">&times;</span>
                        <div id="modalContent"></div>
                    </div>
                    <!-- /Modal content -->
                </div>

                <!-- /The Modal -->
                <!-- TempData check accross all pages -->
                @* The lookup key here used to be " StatusMessage" -- with a LEADING SPACE -- while
                   the guard above it checked "StatusMessage". The key never matched, so the
                   indexer returned null and .ToString() threw. Because this is the layout, ANY
                   page rendered after ANY controller set a StatusMessage died with an unhandled
                   NullReferenceException: the error-reporting mechanism itself took the site down,
                   and it presented as a random 500 on whatever page happened to be next. Null
                   check retained regardless -- TempData values are object and nullable. *@
                @if (TempData.ContainsKey("StatusMessage") && TempData["StatusMessage"] != null)
                {
                    <input type="hidden" id="statusMessage" value="@TempData["StatusMessage"]" />
                }
                <!-- /TempData check accross all pages -->
