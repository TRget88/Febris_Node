    @*This is the loading Queue no idea if it will work*@
    @*<script src="~/JSScriptLib/PartialViewCalls/LoadQueue.js"></script>*@


    <!-- jQuery -->
    <script src="~/gentelella-master/vendors/jquery/dist/jquery.min.js"></script>
    @* ROADMAP 20. Loaded HERE, in <head> immediately after jQuery, rather than at the bottom with
       the other custom scripts: it installs a global ajaxError net, and the net has to be armed
       before any page script gets a chance to fire a request. A page's @@section scripts block runs
       before the bottom-of-body tags, so loading it down there would leave the first request of
       some pages unreported. It needs no DOM beyond document.body, which it looks up lazily. *@
    <script src="~/JSScriptLib/Feedback/StatusMessage.js"></script>
    <!-- Bootstrap -->
    <script src="~/gentelella-master/vendors/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

