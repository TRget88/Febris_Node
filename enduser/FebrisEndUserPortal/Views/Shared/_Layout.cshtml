    @*<link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />*@
    @*<link href="~/css/animate.min.css" rel="stylesheet">*@

    <!-- NProgress -->
    @*<link href="~/gentelella-master/vendors/nprogress/nprogress.css" rel="stylesheet" />*@
