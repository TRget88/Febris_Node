                        @* System. Node Status, Hub Federation and Registration are all
                           [Authorize(Roles = OrgAdmins)] node-configuration screens, and until now
                           NONE of the three had a nav entry -- they existed only if you knew the
                           URL. Grouping them here rather than adding a top-level item per setting
                           is the deliberate siting the node initialization design called for: the
                           next node-wide setting belongs in this section, not in a new one. The
                           gate matches OrgAdmins exactly (IsLocalAdmin covers Admin and ITAdmin,
                           IsLocalFebrisAdmin covers SuperAdmin), so nothing renders that the
                           controller would then refuse. *@
                        @if (User.IsLocalAdmin() || User.IsLocalFebrisAdmin())
                        {
                            <div class="menu_section">
                                <h3>System</h3>
                                <ul class="nav side-menu">
                                    <li>
                                        <a><i class="fa fa-cogs"></i>Node <span class="fa fa-chevron-down"></span></a>
                                        <ul class="nav child_menu">
                                            <li>
                                                <a asp-area="" asp-controller="NodeStatus" asp-action="Index">Status</a>
                                            </li>
                                            <li>
                                                <a asp-area="" asp-controller="RegistrationSettings" asp-action="Index">Registration</a>
                                            </li>
                                            <li>
                                                <a asp-area="" asp-controller="HubFederation" asp-action="Index">Hub Federation</a>
                                            </li>
                                            <li>
                                                @* ROADMAP 16: the feed-sync trigger, moved off the
                                                   API (NodeAdmin-token curl) into a Portal form.
                                                   Node-wide OrgAdmins operation, so it belongs in
                                                   this section per the siting note above. *@
                                                <a asp-area="" asp-controller="LocalSoftwarePackage" asp-action="FeedSync">Package Feed</a>
                                            </li>
                                        </ul>
                                    </li>
                                </ul>
