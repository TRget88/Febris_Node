@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row" style="display:flex">
    <div class="col-md-8">
        <h1 class="text-black">Uh oh...</h1>
        <h2 class="text-black-50">We can't seem to find the page you are looking for.</h2>
    </div>

    <div class="col-md-4">
        <img class="img-fluid" alt=".." src="~/images/Logo/FebrisLogo_Blue.png" />
    </div>
</div>
