@model Febris.ModelLibrary.Models.DataModels.MessageBoard
@using Febris.ModelLibrary.PartialViewModels;
@using Febris.EnumLibrary;  

<head>
    <meta name="viewport" content="width=device-width" />    
    <link href="~/css/Modal.css" rel="stylesheet" />    
</head>   
  
<div class="col-sm-12" align="center" style ="border-radius: 20px; padding:10px; align-items: center;">
    <div class="row" align="center" style="word-wrap: break-word; font-weight: bold; padding-top: 10px;">
        <h1 style="word-wrap: break-word; font-weight: bold;">DetailsModal</h1>
    </div>
</div>
 
<input type="hidden" id="modelId" value="@Model.Id" />   
<br/>
<div>
<div class="row">
    <div class="col-sm-6" align="center" ; style="border-radius: 20px; padding:10px; align-items: center;">
        <div class="row">
            <div class="col-sm-12" align="center" style="font-weight:bold">
                <label class="switch">
                    <input type="checkbox" checked="@Model.Archive" disabled />
                    <span class="slider round"></span>
                </label>
                @Html.DisplayNameFor(model => model.Archive)
            </div>
        </div>
        <div class="row">
            <div class="col-sm-5" align="right" style="font-weight:bold">
                @Html.DisplayNameFor(model => model.TimeStamp)
            </div>
            <div class="col-sm-7" align="left">
                @Html.DisplayFor(model => model.TimeStamp)
            </div>
        </div>
        <div class="row">
            <div class="col-sm-5" align="right" style="font-weight:bold">
                @Html.DisplayNameFor(model => model.LastUpdateTimeStamp)
            </div>
            <div class="col-sm-7" align="left">
                @Html.DisplayFor(model => model.LastUpdateTimeStamp)
            </div>
        </div>
        <div class="row">
            <div class="col-sm-5" align="right" style="font-weight:bold">
                @Html.DisplayNameFor(model => model.UserId)
            </div>
            <div class="col-sm-7" align="left">
                @Html.DisplayFor(model => model.UserId)
            </div>
        </div>
        <div class="row">
            <div class="col-sm-5" align="right" style="font-weight:bold">
                @Html.DisplayNameFor(model => model.UserName)
            </div>
            <div class="col-sm-7" align="left">
                @Html.DisplayFor(model => model.UserName)
            </div>
        </div>
        <div class="row">
            <div class="col-sm-5" align="right" style="font-weight:bold">
                @Html.DisplayNameFor(model => model.UserEmail)
            </div>
            <div class="col-sm-7" align="left">
                @Html.DisplayFor(model => model.UserEmail)
            </div>
        </div>
       
    </div>
    <div class="col-sm-6" align="center" ; style="border-radius: 20px; padding:10px; align-items: center;">
        <div class="row">
            <div class="col-sm-3" align="right" style="font-weight:bold">
                @Html.DisplayNameFor(model => model.Subject)
            </div>
            <div class="col-sm-9" align="left">
                @Html.DisplayFor(model => model.Subject)
            </div>
        </div>
        <div class="row">
            <div class="col-sm-3" align="right" style="font-weight:bold">
                @Html.DisplayNameFor(model => model.Message)
            </div>
            <div class="col-sm-9 line-breaks" align="left">
                @Html.DisplayFor(model => model.Message)
            </div>
        </div>
    </div>
</div>
</div>
<hr/>
<br/>
<div>
<div align="center">                   
    @await Html.PartialAsync("Buttons/GenericButtons/MessageBoard/_DetailsButtonGroupPartial", new IndividualButtonPartial { Id = Model.Id })
</div>
</div>

