@model IEnumerable<Febris.ModelLibrary.Models.DataModels.MessageBoard>

@{
    ViewData["Title"] = "Index";
}

<h1>Your Local Messageboard</h1>

<div class="container">

    <div id="IndexPartial">
        <div class="spinner-border" role="status">
            <span class="visually-hidden"></span>
        </div>
    </div>

</div>
@section scripts
{
    <script>
        function loadIndex() {
            var url = window.location.pathname.split("/");
            var controller = url[1];
            $("#IndexPartial").load("/" + controller + "/MessageIndexPartial")
        }

        window.onload = loadIndex();
    </script>

    @*<script src="~/JSScriptLib/PartialViewCalls/LoadIndexPartial.js"></script>*@
    @* Lowercase "board", matching the file, the function and the calling partial. See the note in
       MessageBoard/Index.cshtml: capital B was a Linux-only 404 that Windows cannot reproduce. *@
    <script src="~/JSScriptLib/ButtonOperation/Specific/MessageboardButtonOperation.js"></script>

}
