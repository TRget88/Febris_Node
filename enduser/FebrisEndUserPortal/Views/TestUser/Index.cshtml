@model IEnumerable<Febris.ModelLibrary.Models.DataModels.TestUser>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<div class="row">
    <div class="col-xs-6">
        <a asp-action="CreateTestUser" class="btn btn-success" data-toggle="tooltip" title="Test User Creation">
            <span class="glyphicon glyphicon-plus glyphicon-plus"> </span>
        </a>       
    </div>    
</div>
<div class="container">  
<div id="IndexPartial">
        <div class="spinner-border" role="status">
            <span class="visually-hidden"></span>
        </div>
    </div>    
</div>
@section scripts
{    
    <script src="~/JSScriptLib/PartialViewCalls/LoadIndexPartial.js"></script>
    @* TestUserButtonOperation.js is NOT included, and must not be. It never existed in this portal
       (nor in the EndUser portal in the retired SVN tree) -- the tag was a copy-paste from the
       central and developer portals, which drive their buttons through a SPECIFIC
       TestUserButtonAction. This portal's TestUser buttons use the GENERIC path instead:
       GenericButtons/TestUser/_IndexButtonGroupPartial renders Buttons/_IndividualButtonPartial,
       whose onclick is ButtonAction(this), and GenericButtonOperation.js:233 already routes
       "TestUserDetails" to /TestUser/DetailsModal. That script is loaded for every page by
       _Layout.cshtml, so the buttons work without this tag and only 404ed with it. *@

}
