@model Febris.ModelLibrary.Models.DataModels.TestUser
@using Febris.ModelLibrary.PartialViewModels;
@using Febris.EnumLibrary;

<head>
    <meta name="viewport" content="width=device-width" />
    <link href="~/css/Modal.css" rel="stylesheet" />
</head>

<div class="col-sm-12" align="center" style="border-radius: 20px; padding:10px; align-items: center;">
    <div class="row" align="center" style="word-wrap: break-word; font-weight: bold; padding-top: 10px;">
        <h1 style="word-wrap: break-word; font-weight: bold;">@Model.FirstName @Model.LastName</h1>
    </div>
</div>
<br />
<hr />
<input type="hidden" id="modelId" value="@Model.Id" />
<div class="row">
    <div class="col-sm-6" align="center"  style="border-radius: 20px; padding:10px; align-items: center;">
        <div class="row">
            <div class="col-sm-5" align="right" style="font-weight:bold">
                @Html.DisplayNameFor(model => model.TimeStamp)
            </div>
            <div class="col-sm-7" align="left">
                @Html.DisplayFor(model => model.TimeStamp)
            </div>
        </div>
        <div class="row">
            <div class="col-sm-5" align="right" style="font-weight:bold">
                @Html.DisplayNameFor(model => model.UserName)
            </div>
            <div class="col-sm-7" align="left">
                @Html.DisplayFor(model => model.UserName)
            </div>
        </div>
        @*<div class="row">
            <div class="col-sm-5" align="right" style="font-weight:bold">
                @Html.DisplayNameFor(model => model.UserAccountType)
            </div>
            <div class="col-sm-7" align="left">
                @Html.DisplayFor(model => model.UserAccountType)
            </div>
        </div>*@
        <hr />
        <h3>Actor Info</h3>
        <input type="hidden" id="Element0" value="ActorInfo" />
        <div id="Division0" align="center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden"></span>
            </div>
        </div>
    </div>
    <div class="col-sm-6" align="center"  style="border-radius: 20px; padding:10px; align-items: center;">
        @* ROADMAP 17 owner ruling 2026-08-24: fix, do not delete. This render was commented out, so
           the entitlement-checked image server was unreachable and every test user showed the
           default picture. The commented version also had the WRONG PROPERTY PATH
           (Model.ProfessionalSettings.PhotoOfProfessional): the photo lives directly on TestUser,
           so uncommenting it as written would not have compiled. Blank paths render the default
           rather than asking the loader for nothing. *@
        @if (!string.IsNullOrWhiteSpace(Model.PhotoOfProfessional))
        {
            <img src="@Url.Action("ImageLoader","Widget",new {path=Model.PhotoOfProfessional})" class="img-fluid" alt="Image"  />
        }
        else
        {
            <img src="~/images/DefaultMedia/DefaultPerson.png" class="img-fluid" alt="Default Image"  />
        }
    </div>
</div>
<br />
@*<div>
    <div align="center">
        @await Html.PartialAsync("Buttons/GenericButtons/TestUser/_DetailsButtonGroupPartial", new IndividualButtonPartial { Id = Model.Id })
    </div>
</div>*@

<br />


<br />
<hr />



<script src="~/JSScriptLib/PartialViewCalls/LoadViewDetails.js"></script>