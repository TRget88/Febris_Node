@model Febris.ModelLibrary.ViewModels.CohortAccessListViewModel
@using Febris.ModelLibrary.PartialViewModels

@*
    Was MarketplaceAccessListing. A node's cohort access is curriculum-derived: the cohort is
    linked to curricula and every member inherits that access, so Seats is the cohort's member
    count. The previous version read the hub's purchase records and rendered an empty table on
    any self-hosted node.
*@
<table class="table">
    <thead>
        <tr>
            <th>
                Curriculum Name
            </th>
            <th>
                Curriculum Description
            </th>
            <th>
                Version
            </th>
            <th>
                Members with access
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.AccessList != null)
        {
            @foreach (var item in Model.AccessList)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Curriculum.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Curriculum.Description)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Curriculum.Version)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Seats)
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
