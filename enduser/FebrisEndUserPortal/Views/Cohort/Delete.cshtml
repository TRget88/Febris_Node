@model Febris.ModelLibrary.Models.DataModels.Cohort

@{
    ViewData["Title"] = "Delete cohort";
}

<h2>Delete cohort</h2>

<h3>Are you sure you want to delete this cohort?</h3>

@* This is the irreversible one. Archive is the ordinary way to retire a cohort and is reversible
   from the index, so the confirm page says so rather than letting someone reach for delete by
   default. The two lists below are the owner ruling of 2026-08-09 stated plainly: the cohort and
   its link rows go, and nothing on the other side of those links is touched. *@
<div class="alert alert-danger">
    <strong>This cannot be undone.</strong>
    If you only want the cohort out of the way, use the <strong>Archive</strong> switch on the
    cohort list instead. Archiving is reversible.
</div>

<div class="row">
    <div class="col-md-6">
        <div class="alert alert-warning">
            <strong>Deleted with the cohort</strong>
            <ul class="mb-0">
                <li>Its cohort memberships</li>
                <li>Its curriculum links</li>
                <li>Its location links</li>
                <li>Its hardware assignments</li>
            </ul>
        </div>
    </div>
    <div class="col-md-6">
        <div class="alert alert-success">
            <strong>Not touched</strong>
            <ul class="mb-0">
                <li>The user accounts themselves</li>
                <li>The curricula themselves</li>
                <li>The locations themselves</li>
                <li>The devices themselves</li>
            </ul>
        </div>
    </div>
</div>

<div>
    <h4>Cohort</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Archive)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Archive)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.UUID)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.UUID)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.TimeStamp)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.TimeStamp)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.LastUpdateTimeStamp)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.LastUpdateTimeStamp)
        </dd>
    </dl>

    @* Tag-helper form, so the antiforgery token is emitted automatically. The global
       AutoValidateAntiforgeryTokenAttribute filter is on, and DeleteConfirmed also carries an
       explicit [ValidateAntiForgeryToken]. *@
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete this cohort" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
