<div align="center">
    <hr />
    <h4>Attachments Info</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Usage Type</th>
                <th>Display</th>
                <th>Description</th>
                <th>Content Type</th>                
                <th>File URL</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Attachments)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.UsageType)
                    </td>
                    <td>
                        @item.Display?.Values.FirstOrDefault()
                    </td>
                    <td>
                        @item.Description?.Values.FirstOrDefault()

                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ContentType)
                    </td>
                    <td>
                        <button url="@item.FileURL" class="btn btn-info" title="Follow path" onclick="loadFileUrl(this)">
                            <span class="fa fa-file"></span>
                        </button>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<br />
@*
    The statement action buttons. The block that used to be here was commented out AND pointed at
    "Buttons/GenericButtons/LocalStatement/_DetailsButtonGroupPartial", a partial that does not exist
    anywhere in the repo, so it could never have rendered even uncommented.

    NO admin gate at this level. The group renders for anyone who can see the statement, because the
    download inside it is available to them, and the partial decides for itself which buttons the
    caller gets. Gating here instead would have hidden the download from every educator and learner,
    which is the opposite of how the 2021 Portal had it.

    Presentation only. The controller attribute and the BLL gates are what actually stop a request.
*@
@if (Model != null)
{
    <div>
        <div align="center">
            @await Html.PartialAsync("Buttons/GenericButtons/Statement/_StatementActionsButtonGroupPartial",
                 new IndividualUUIDButtonPartial { Id = Model.UUID })
        </div>
    </div>
}

