        @* Audit T2. Authority is whatever the SUBMITTING CLIENT asserted -- the node never sets
           it, never verifies it, and never uses it for any authorization decision. Rendering it
           unlabelled presented a self-declared identity, email address included, as though the node
           had established it. The values are still shown, because they are part of the statement
           record and suppressing them would hide what was actually stored, but they are now framed
           as a claim rather than a fact. *@
        @if (Model.Authority != null)
        {
            <hr />
            <h4>Authority Info</h4>
            <div class="alert alert-warning">
                <strong>Claimed by the submitting client.</strong>
                This node does not set or verify the authority on a statement, and does not use it
                for access decisions. Treat it as self-declared.
            </div>
            <div class="row">
                <div class="col-sm-5" align="right" style="font-weight:bold">
                    @Html.DisplayNameFor(model => model.Authority.Actor.Name)
                </div>
                <div class="col-sm-7" align="left">
