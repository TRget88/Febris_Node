@model IEnumerable<Febris.ModelLibrary.Models.XApiModels.ModifiedForSharing.LocalStatement>

@{
    ViewData["Title"] = "Index";
}

<h1>Statement Index</h1>


<div class="container">  
<div id="IndexPartial">
        <div class="spinner-border" role="status">
            <span class="visually-hidden"></span>
        </div>
    </div>     
</div>
@section scripts
{    
    <script src="~/JSScriptLib/PartialViewCalls/LoadIndexPartial.js"></script>    
    @* Was LocalStatementButtonOperation.js, which does not exist anywhere in the repo -- this tag
       had been returning 404 and StatementButtonAction was undefined on this page. Nothing depended
       on it yet: the index row's Details button goes through the global ButtonAction handler. The
       void button does need it, so the include now points at the file that is actually here. *@
    <script src="~/JSScriptLib/ButtonOperation/Specific/StatementButtonOperation.js"></script>
}
