@model IEnumerable<Febris.ModelLibrary.Models.DataModels.Location>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<div class="row">
    <div class="col-xs-6">
        <a asp-action="create" class="btn btn-success" data-toggle="tooltip" title="Location Creation">
            <span class="glyphicon glyphicon-plus glyphicon-plus"> </span>
        </a>
    </div>
</div>
<div class="container">
    @* Collapsed to one full-width partial, matching Views/Cohort/Index.cshtml. The right-hand
       #SecondPartial column used to load /Widget/MapPartial, a Leaflet map that was broken at three
       independent levels (no leaflet.js vendored, GeoDataUrls never bound, no .mapData markers ever
       emitted). The owner ruled "remove the map surface, do not vendor the library"; ROADMAP 18
       executed it. *@
    <div id="IndexPartial">
        <div class="spinner-border" role="status">
            <span class="visually-hidden"></span>
        </div>
    </div>
</div>
@section scripts
{
    <script src="~/JSScriptLib/PartialViewCalls/LoadIndexPartial.js"></script>
    <script src="~/JSScriptLib/ButtonOperation/Specific/LocationButtonOperation.js"></script>
}
