@model X.PagedList.IPagedList<Febris.ModelLibrary.Models.DataModels.Module>

@using X.PagedList.Mvc.Core
@using X.PagedList.Mvc
@using X.PagedList
@using Febris.ModelLibrary.PartialViewModels

<div id="tablePartial">
    <div id="search">
        @using (Html.BeginForm())
        {
            <p>
                @Html.TextBox("SearchString", null, new { id = "searchBox", type = "text" })
                <input type="submit" value="Search" class="fa fa-search btn btn-primary" />
            </p>
        }
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>
                    Toggle Link
                </th>
                <th>
                    Obsolete
                </th>

                <th>
                    Name
                </th>
                <th>
                    Version
                </th>
                <th>
                    Description
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if(Model != null){
        @foreach (var item in Model) {
            <tr>
                <td>
                    <label class="switch">
                        <input type="checkbox" onchange="AddItem(this)" moduleId="@item.Id" />
                        <span class="slider round"></span>
                    </label>
                </td>
                <td>
                    <label class="switch">
                        <input type="checkbox" checked="@item.Obsolete" disabled />
                        <span class="slider round"></span>
                    </label>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Version)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                @await Html.PartialAsync("Buttons/GenericButtons/Module/_IndexButtonGroupPartial", new IndividualButtonPartial { Id = item.Id })
            </tr>
        }}
        </tbody>
    </table>
    <div id="pagedList">
    @if(TempData.ContainsKey("CurrentFilter")){
        @Html.PagedListPager(Model, page => Url.Action("AccessableModuleIndexPartial", new { page = page, currentFilter = TempData["CurrentFilter"].ToString()}));
    }
    else{
        @Html.PagedListPager(Model, page => Url.Action("AccessableModuleIndexPartial", new { page = page }));
    }        
    </div>
</div>    
<script>
$(function () {
    $('#pagedList').on('click', 'a', function () {
        $.ajax({
            url: this.href,
            type: 'GET',
            cache: false,
            success: function (result) {
                $('#tablePartial').html(result);
            }
        });
        return false;
    });
});
$(function () {
    $('#search').submit(function (event) {
        event.preventDefault();
        var searchString = document.getElementById("searchBox").value;
        $.ajax({
            url: "../Hardware/AccessableModuleIndexPartial",
            async: true,
            data: 'searchString=' + searchString,
            type: 'GET',
            cache: false,
            success: function (result) {
                $('#tablePartial').html(result);
            },
            error: function (xhr, param) {
                console.log(xhr);
                console.log(param);
            }
        });
        return false;
    });
});
</script>
