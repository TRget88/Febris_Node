@model Febris.ModelLibrary.ViewModels.LocalHardwareCreationViewModel
@using Febris.EnumLibrary;
@{
    ViewData["Title"] = "Edit";
}

<h2>Edit</h2>

<h4>Hardware</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Hardware.Id" />
            <input type="hidden" asp-for="Hardware.UUID" />
            <div class="form-group">
                <div>
                    <label class="switch">
                        <input type="checkbox" asp-for="Hardware.IsLockedOut" /> @Html.DisplayNameFor(model => model.Hardware.IsLockedOut)
                        <span class="slider round"></span>
                    </label>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Hardware.HardwareCondition" class="control-label"></label>
                <select asp-for="Hardware.HardwareCondition" class="form-control" asp-items="Html.GetEnumSelectList<HardwareCondition>()"></select>
                <span asp-validation-for="Hardware.HardwareCondition" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Hardware.HardwareKind" class="control-label"></label>
                <select asp-for="Hardware.HardwareKind" class="form-control" asp-items="@Html.GetEnumSelectList<HardwareKind>()"></select>
                <span asp-validation-for="Hardware.HardwareKind" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Hardware.DescriptiveName" class="control-label"></label>
                <input asp-for="Hardware.DescriptiveName" class="form-control" />
                <span asp-validation-for="Hardware.DescriptiveName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Hardware.Description" class="control-label"></label>
                <textarea asp-for="Hardware.Description" class="form-control" rows="5"></textarea>                
                <span asp-validation-for="Hardware.Description" class="text-danger"></span>
            </div>
            @* Deliberately absent (audit T9). The stored value is a HASH, so an editable field
               here would either display a hash or overwrite a valid one with typed text and silently
               lock the device out. Issuing a new credential is an explicit, destructive action --
               Regenerate Credential on the device list. *@


            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
