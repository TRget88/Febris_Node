    <script>
        // Audit C-07: these actions are now [HttpPost] + [ValidateAntiForgeryToken], so the
        // request carries the token. Previously a bare $.get, which meant any page a logged-in
        // admin visited could trigger the same state change with an image tag.
        function AntiForgeryToken() {
            return $('#antiForgeryHolder input[name="__RequestVerificationToken"]').val();
        }
    </script>
    @* Token holder for the tokenised POSTs above. Never submitted; the helper reads the value. *@
    <form id="antiForgeryHolder">
        @Html.AntiForgeryToken()
    </form>
