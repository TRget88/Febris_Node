@model Febris.ModelLibrary.Models.DataModels.LocalHardware

@{
    ViewData["Title"] = "ManageCohortIndex";
}

<h1>Manage Modules On Hardware </h1>
<input type="hidden" value="@Model.Id" id="inputVariable" />

<div class="container">
    <div class="row">
        <div class="col-sm-6">
            <div id="IndexPartial">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden"></span>
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div id="SecondPartial">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden"></span>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script>
        var inputVariable = document.getElementById("inputVariable");
        function loadSecond() {
            var url = window.location.pathname.split("/");
            var controller = url[1];
            $("#IndexPartial").load("/" + controller + "/ManageCohortIndexPartial?id=" + inputVariable.value)
            $("#SecondPartial").load("/" + controller + "/AccessableCohortIndexPartial")
        }

        window.onload = loadSecond();
    </script>
    <script>
        // ROADMAP 20: these used confirm("Item added.") / confirm("Item removed.") on the SUCCESS
        // callback only. Three defects in one line. It fired only when the call succeeded, so a
        // refusal or a dropped request said nothing at all. It asked a yes/no question about
        // something that had already happened, which is not a decision the user can make. And
        // answering Cancel skipped loadSecond(), leaving the two lists showing membership the
        // database no longer had -- so declining a pointless prompt silently desynced the screen.
        //
        // Success is announced by a toast and the lists always refresh. Failure is reported by the
        // global net in StatusMessage.js, which is why there is no .fail() here: adding one would
        // show two messages for one failure.
        function AddItem(data) {
            var itemId = $(data).attr('cohortId');
            var url = window.location.pathname.split("/");
            var controller = url[1];
            $.post("/" + controller + "/AddCohort", { hardwareId: inputVariable.value, cohortId: itemId, __RequestVerificationToken: AntiForgeryToken() }, function (data) {
                window.StatusMessage.ok("Cohort added.");
                loadSecond();
            });
        }

        function RemoveItem(data) {
            var linkId = $(data).attr('linkId');
            var url = window.location.pathname.split("/");
            var controller = url[1];
            $.post("/" + controller + "/RemoveCohort", { id: linkId, __RequestVerificationToken: AntiForgeryToken() }, function (data) {
                window.StatusMessage.ok("Cohort removed.");
                loadSecond();
            });
        }



