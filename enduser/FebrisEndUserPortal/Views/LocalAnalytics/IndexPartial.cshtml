@model X.PagedList.IPagedList<Febris.ModelLibrary.Models.AnalyticsModels.LocalAnalytics>
@using X.PagedList.Mvc.Core
@using X.PagedList.Mvc
@using X.PagedList
@using Febris.ModelLibrary.PartialViewModels

<div id="tablePartial">
    <div id="search">
        @using (Html.BeginForm())
        {
            <p>
                @Html.TextBox("SearchString", null, new { id = "searchBox", type = "text" })
                <input type="submit" value="Search" class="fa fa-search btn btn-primary" />
            </p>
        }
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>
                    Timestamp
                </th>
                @*<th>
                    Duration
                </th>*@
                <th>
                    IP
                </th>
                <th>
                    User Agent
                </th>
                @*<th>
                    Query
                </th>*@
                <th>
                    Referer
                </th>
                <th>
                    Path
                </th>
                <th>
                    SourceId
                </th>
                @*<th>
                    Visits
                </th>*@
                @*<th></th>*@
            </tr>
        </thead>
        <tbody>
        @if(Model != null){
        @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.TimeStamp)
                </td>
                @*<td>
                    @Html.DisplayFor(modelItem => item.TimeSpan)
                </td>*@
                <td>
                    @Html.DisplayFor(modelItem => item.IPAddress)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UserAgent)
                </td>
                @*<td>
                    @Html.DisplayFor(modelItem => item.Query)
                </td>*@
                <td>
                    @Html.DisplayFor(modelItem => item.Referer)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Path)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SourceId)
                </td>
                @*<td>
                    @Html.DisplayFor(modelItem => item.Visits)
                </td>*@

                @*@await Html.PartialAsync("Buttons/GenericButtons/LocalAnalytics/_IndexButtonGroupPartial", new IndividualButtonPartial { Id = item.Id })*@

            </tr>
        }}
        </tbody>
    </table>
    <div id="pagedList">
    @if(TempData.ContainsKey("CurrentFilter")){
        @Html.PagedListPager(Model, page => Url.Action("IndexPartial", new { page = page, currentFilter = TempData["CurrentFilter"].ToString()}));
    }
    else{
        @Html.PagedListPager(Model, page => Url.Action("IndexPartial", new { page = page }));
    }        
    </div>
</div>    
<script>
$(function () {
    $('#pagedList').on('click', 'a', function () {
        $.ajax({
            url: this.href,
            type: 'GET',
            cache: false,
            success: function (result) {
                $('#tablePartial').html(result);
            }
        });
        return false;
    });
});
$(function () {
    $('#search').submit(function (event) {
        event.preventDefault();
        var searchString = document.getElementById("searchBox").value;
        $.ajax({
            url: "../LocalAnalytics/IndexPartial",
            async: true,
            data: 'searchString=' + searchString,
            type: 'GET',
            cache: false,
            success: function (result) {
                $('#tablePartial').html(result);
            },
            error: function (xhr, param) {
                console.log(xhr);
                console.log(param);
            }
        });
        return false;
    });
});
</script>
