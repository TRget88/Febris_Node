@model Febris.ModelLibrary.Models.DataModels.Curriculum

@{
    ViewData["Title"] = "Modules";
}

<h1>Modules in @Model.Name</h1>
<hr />

@*
    Single column on purpose. The hub split "all modules" and "linked modules" into two partials
    and fired a setTimeout to reconcile them; the node partial carries membership inline, so one
    list with checked state is both simpler and race-free.
*@
<input id="itemForLinking" value="@Model.UUID" hidden />
@Html.AntiForgeryToken()

<div class="container">
    <div id="IndexPartial">
        <div class="spinner-border" role="status">
            <span class="visually-hidden"></span>
        </div>
    </div>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Back to Curriculum</a>
    &nbsp;|&nbsp;
    <a asp-action="Index">Back to List</a>
</div>

@section scripts {
    <script>
        function loadLinkingIndex() {
            $("#IndexPartial").load("/Curriculum/LinkingIndexPartial?id=@Model.Id");
        }

        function togglelink(sender) {
            $.ajax({
                url: "/Curriculum/ToggleModuleToCurriculumLink",
                type: "POST",
                data: {
                    curriculumGuid: document.getElementById("itemForLinking").value,
                    moduleGuid: $(sender).val(),
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                // The server returns the RESULTING membership state, so the checkbox reflects what
                // was actually persisted rather than what the click optimistically implied.
                //
                // ROADMAP 20: that answer is also the only way to tell a refusal from a success
                // here, since both arrive as HTTP 200. If the state came back unchanged, the server
                // declined, and the global net cannot see it.
                success: function (linked) {
                    var wanted = sender.checked;
                    sender.checked = linked;
                    if (linked === wanted) {
                        window.StatusMessage.ok(linked ? "Module linked." : "Module unlinked.");
                    } else {
                        window.StatusMessage.refused(
                            wanted ? "Not linked." : "Not unlinked.",
                            "The server left it as it was.");
                    }
                },
                // Repair only -- the failure is reported by the global net in StatusMessage.js.
                error: function () { sender.checked = !sender.checked; }
            });
        }

        loadLinkingIndex();
    </script>
}
