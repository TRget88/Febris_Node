@model X.PagedList.IPagedList<Febris.ModelLibrary.Models.DataModels.Curriculum>
@using X.PagedList.Mvc.Core
@using X.PagedList.Mvc
@using X.PagedList
@using Febris.ModelLibrary.PartialViewModels

<div id="tablePartial">
    <div id="search">
        @using (Html.BeginForm())
        {
            <p>
                @Html.TextBox("SearchString", null, new { id = "searchBox", type = "text" })
                <input type="submit" value="Search" class="fa fa-search btn btn-primary" />
            </p>
        }
    </div>
    @{ bool includeObsolete = ViewData["IncludeObsolete"] as bool? ?? false; }
    @Html.AntiForgeryToken()
    <input id="includeObsoleteFlag" type="hidden" value="@includeObsolete.ToString().ToLower()" />
    <p>
        <label>
            <input type="checkbox" id="showArchived" onchange="reloadIndex()" checked="@includeObsolete" />
            Show archived (obsolete) curricula
        </label>
    </p>
    <table class="table">
        <thead>
            <tr>
                <th>Obsolete</th>
                <th>Name</th>
                <th>Version</th>
                <th>Last Mod Date</th>                
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if(Model != null){
        @foreach (var item in Model) {
            <tr>
                <td>
                    @* Live control, not a disabled indicator. Soft delete is only useful if it can
                       be undone, and an obsoleted curriculum is hidden from the default list -- so
                       without a working toggle here (plus the archived view below) there was no way
                       back once a curriculum was retired. *@
                    <label class="switch">
                        <input type="checkbox"
                               checked="@item.Obsolete"
                               value="@item.Id"
                               onchange="toggleObsolete(this)" />
                        <span class="slider round"></span>
                    </label>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Version)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LastUpdateTimeStamp)
                </td>                
                
                        @await Html.PartialAsync("Buttons/GenericButtons/Curriculum/_IndexButtonGroupPartial", new IndividualButtonPartial { Id = item.Id })
                    
            </tr>
        }}
        </tbody>
    </table>
    <div id="pagedList">
    @if(TempData.ContainsKey("CurrentFilter")){
        @Html.PagedListPager(Model, page => Url.Action("IndexPartial", new { page = page, currentFilter = TempData["CurrentFilter"].ToString()}));
    }
    else{
        @Html.PagedListPager(Model, page => Url.Action("IndexPartial", new { page = page }));
    }        
    </div>
</div>    
<script>
$(function () {
    $('#pagedList').on('click', 'a', function () {
        $.ajax({
            url: this.href,
            type: 'GET',
            cache: false,
            success: function (result) {
                $('#tablePartial').html(result);
            }
        });
        return false;
    });
});
// Reload the partial preserving the archived flag. Declared on window so the inline onchange
// handlers keep working after the partial replaces its own markup.
window.reloadIndex = function () {
    var showArchived = document.getElementById("showArchived").checked;
    $('#tablePartial').load("/Curriculum/IndexPartial?includeObsolete=" + showArchived);
};

// Archive / restore. Posts the RESULTING state back onto the checkbox so it reflects what was
// actually persisted, and reloads only when a row would drop out of the current view -- archiving
// while the archived filter is off means the row is no longer part of this list.
window.toggleObsolete = function (sender) {
    var makeObsolete = sender.checked;
    var showArchived = document.getElementById("includeObsoleteFlag").value === "true";
    $.ajax({
        url: "/Curriculum/ObsoleteToggle",
        type: "POST",
        data: {
            Id: $(sender).val(),
            obsolete: makeObsolete,
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        // ROADMAP 20. This endpoint answers a REFUSAL with HTTP 200 and a false body, which the
        // global net in StatusMessage.js cannot see -- as far as jQuery is concerned the request
        // succeeded. So the refusal has to be announced here, or it stays exactly as silent as it
        // was: the checkbox springs back and the operator is left guessing whether they misclicked.
        success: function (ok) {
            if (!ok) {
                sender.checked = !makeObsolete;
                window.StatusMessage.refused(
                    makeObsolete ? "Not archived." : "Not restored.",
                    "The server refused the change. It may be in use, or you may not have permission.");
                return;
            }
            window.StatusMessage.ok(makeObsolete ? "Curriculum archived." : "Curriculum restored.");
            if (!showArchived) { window.reloadIndex(); }
        },
        // Repair only -- the transport failure itself is reported by the global net.
        error: function () { sender.checked = !makeObsolete; }
    });
};

$(function () {
    $('#search').submit(function (event) {
        event.preventDefault();
        var searchString = document.getElementById("searchBox").value;
        $.ajax({
            url: "../Curriculum/IndexPartial",
            async: true,
            data: 'searchString=' + searchString + '&includeObsolete=' + (document.getElementById("showArchived").checked),
            type: 'GET',
            cache: false,
            success: function (result) {
                $('#tablePartial').html(result);
            },
            error: function (xhr, param) {
                console.log(xhr);
                console.log(param);
            }
        });
        return false;
    });
});
</script>
