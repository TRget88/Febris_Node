@model Febris.UserNode.Portal.ViewModels.CurriculumModuleLinkingViewModel

@*
    Every module on the node, with a checkbox reflecting whether it is currently in this
    curriculum. Membership arrives as a UUID set so each row is an O(1) lookup rather than a
    second query per module.
*@
<table class="table">
    <thead>
        <tr>
            <th>In curriculum</th>
            <th>Name</th>
            <th>Version</th>
            <th>Classification</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.ModuleList != null)
        {
            @foreach (var item in Model.ModuleList)
            {
                <tr>
                    <td>
                        <label class="switch">
                            <input type="checkbox"
                                   value="@item.UUID"
                                   onchange="togglelink(this)"
                                   checked="@(Model.LinkedModuleUuidList != null && Model.LinkedModuleUuidList.Contains(item.UUID))" />
                            <span class="slider round"></span>
                        </label>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Version)
                    </td>
                    <td>
                        @* Nullable navigation: an unclassified module would NRE a bare dereference. *@
                        @(item.ModuleClassification?.Name ?? "")
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (Model == null || Model.ModuleList == null || !Model.ModuleList.Any())
{
    <p class="text-muted">
        No modules on this node yet. Modules arrive through package ingest before they can be
        added to a curriculum.
    </p>
}
