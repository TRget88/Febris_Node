@*
    No @model directive: the Index action returns View() with no model and nothing below
    dereferences one. The previous "@model ...DataModels.Curriculum" was inert.
*@
@{
    ViewData["Title"] = "Index";
}

@* Was "Cohort Index" -- a copy-paste artifact from the Cohort views. *@
<h1>Curriculum Index</h1>

<div class="row">
    <div class="col-xs-6">
        <a asp-action="Create" class="btn btn-success" data-toggle="tooltip" title="Curriculum Creation">
            <span class="glyphicon glyphicon-plus glyphicon-plus"> </span>
        </a>
    </div>
</div>

<div class="container">
    <div id="IndexPartial">
        <div class="spinner-border" role="status">
            <span class="visually-hidden"></span>
        </div>
    </div>
</div>
@section scripts
{
    <script src="~/JSScriptLib/PartialViewCalls/LoadIndexPartial.js"></script>
    <script src="~/JSScriptLib/ButtonOperation/Specific/CurriculumButtonOperation.js"></script>
}
