@model IEnumerable<Febris.ModelLibrary.Models.UserModels.LocalApplicationUser>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@* Bulk import is DELIBERATELY not offered on this page, and the commented-out block below is
   the original. Educator and Admin accounts carry more control than a learner account, so they
   are created one at a time, on purpose, rather than pasted in from a spreadsheet. Owner-confirmed
   2026-08-21. The shared add-users partial takes `false` for the same reason -- do not "tidy" this
   by switching it on. *@
@await Html.PartialAsync("Buttons/GenericButtons/User/_AddUsersButtonGroupPartial", false)
<div class="container">
    <div id="IndexPartial">
        <div class="spinner-border" role="status">
            <span class="visually-hidden"></span>
        </div>
    </div>

</div>
@section scripts
{
    <script>

        function loadIndex() {
            var url = window.location.pathname.split("/");
            var controller = url[1];
            $("#IndexPartial").load("/" + controller + "/EducatorIndexPartial")
        }

        window.onload = loadIndex();

    </script>
    <script src="~/JSScriptLib/ButtonOperation/Specific/UserButtonOperation.js"></script>
}
