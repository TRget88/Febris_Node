<hr />
@*<form asp-action="BulkCreatePost">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>*@
<div class="row" style="text-align: center;">
    <div class="col-1">
        <button id="exportRemovalJsonData" type="button" class="btn btn-lg btn-danger glyphicon glyphicon-minus-sign" value="Export Removal JSON Data"></button>
    </div>
    <div class="flex-fill col-8">
        @*<button id="exportRemovalJsonData" type="button" class="btn btn-lg btn-danger glyphicon glyphicon-minus" value="Export JSON Data"></button>*@
        <textarea rows="1" id="excelPasteBox" placeholder="Paste your excel form data here with proper format..."></textarea>
    </div>
    <div class="col-1">
        @*<div class="form-group">
                <input type="submit" value="Create" id="exportJsonData" class="btn btn-lg btn-success glyphicon glyphicon-plus" />
            </div>*@
        <button id="exportJsonData" type="button" class="btn btn-lg btn-success glyphicon glyphicon-plus" value="Export JSON Data"></button>
    </div>

</div>
<hr />
@* CSV alternative to the paste box: same columns, same order, no header row. Parsed
   server-side by ICsvUserImporter (User/BulkCreateCsvPost), which feeds the same create
   path as the paste flow. The action existed, was registered and tested, but no form
   posted to it until ROADMAP 17. *@
<div class="row" style="text-align: center;">
    <div class="col-1"></div>
    <div class="flex-fill col-8">
        <input type="file" id="csvUploadFile" accept=".csv,text/csv" />
    </div>
    <div class="col-1">
        <button id="uploadCsvData" type="button" class="btn btn-lg btn-success glyphicon glyphicon-upload" value="Upload CSV" title="Upload CSV"></button>
    </div>
</div>
<hr />
<div id="output">
    <table id="excelDataTable" class="flex-table"></table>
</div>
<hr />

@* Antiforgery token holder. Rendered INSIDE the partial because the partial is AJAX-loaded
   into #BulkInput, so a token on the parent page would not survive the swap. Same reason as
   Views/Cohort/IndexPartial.cshtml. The bulk scripts read it by name and send it as the
   RequestVerificationToken header. *@
@Html.AntiForgeryToken()

<script src="~/JSScriptLib/TableScripts/BulkProcessing.js"></script>
<script src="~/JSScriptLib/TableScripts/BulkUserProcessing.js"></script>
