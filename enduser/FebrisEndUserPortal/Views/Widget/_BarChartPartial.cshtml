@model Febris.ModelLibrary.ViewModels.BarChart


<div class="x_panel">
    <div class="x_title">
        <h2>@Model.Title<small>@Model.Description</small></h2>
        <ul class="nav navbar-right panel_toolbox">
            @*<li>
                <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
            </li>*@
            @*<li class="dropdown">
                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false"><i class="fa fa-wrench"></i></a>
                <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                    <a class="dropdown-item" href="#">Settings 1</a>
                    <a class="dropdown-item" href="#">Settings 2</a>
                </div>
            </li>*@
            <li>
                <a class="close-link"><i class="fa fa-close"></i></a>
            </li>
        </ul>
        <div class="clearfix"></div>
    </div>
    <div class="x_content">
        <canvas id="@Model.IdToUse"></canvas>
    </div>
</div>

<script>

    var chartdata = @Html.Raw(Json.Serialize(Model.ChartEntryList));
    var labels = [];
    var data = [];
    $.each(chartdata, function (index, value) {
        labels.push(value.label);
        data.push(value.quantity);
    });
    var ctx = document.getElementById(@Html.Raw(Json.Serialize(Model.IdToUse))).getContext('2d');

    var chart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                data: data,
                fill: true,
                borderColor: 'rgb(75, 192, 192)',
                backgroundColor: 'rgba(75, 192, 192, 0.2)',
                //tension: 0.1,
                borderWidth: 1
            }]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        },
    });



</script>

<script src="~/js/site.js"></script>