@page
@model NodeAccountActivationModel
@{
    ViewData["Title"] = "Set your password";
}

<h1>@ViewData["Title"]</h1>

@if (!Model.LinkUsable)
{
    <div class="row">
        <div class="col-md-6">
            <div class="alert alert-warning">@NodeAccountActivationModel.LinkFailureMessage</div>
            <p>
                <a asp-page="./Login">Go to sign in</a>
                &middot;
                <a asp-page="./ForgotPassword">Forgot password</a>
            </p>
        </div>
    </div>
}
else
{
    <h4>An account has been created for you. Choose a password to finish setting it up.</h4>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                @* The token posts back in a hidden field so the browser submits to a clean URL, and
                   so nothing is spent by merely fetching the page. *@
                <input asp-for="Input.Code" type="hidden" />

                <div class="form-group">
                    <label asp-for="Input.Email"></label>
                    @* Asked for rather than shown. Displaying it would mean resolving the account
                       from the URL before the token is verified, which is how the central tier's
                       equivalent page became an email-disclosure oracle. *@
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Password"></label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.ConfirmPassword"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Set password and sign in</button>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
