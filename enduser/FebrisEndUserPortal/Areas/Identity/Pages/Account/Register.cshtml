@page
@model RegisterModel
@{
    ViewData["Title"] = Model.SelfRegistrationEnabled ? "Register" : "Sign in";
}

@*
    Registration is gate-driven by the operator's "Identity:Registration:Mode" configuration
    (docs IDENTITY_POLICY_GATES):
      - AdminOnly / Invite (safe default): registration stays closed -- the informational prompt
        below plus any configured external providers.
      - Open / DomainAllowlist: the self-registration form renders. The server re-checks the gate
        on POST, so exposing the form is cosmetic, not the security boundary.
*@

@if (Model.SelfRegistrationEnabled)
{
    <h1>Register</h1>

    <div class="row">
        <div class="col-md-4">
            <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <h4>Create a new account.</h4>
                <hr />
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Input.FirstName"></label>
                    <input asp-for="Input.FirstName" class="form-control" />
                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.LastName"></label>
                    <input asp-for="Input.LastName" class="form-control" />
                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" class="form-control" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Password"></label>
                    <input asp-for="Input.Password" class="form-control" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.ConfirmPassword"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Register</button>
            </form>
            <p class="mt-2">
                Already have an account?
                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in here</a>.
            </p>
        </div>
    </div>
}
else
{
    <h1>Sign in</h1>

    <div class="row">
        <div class="col-md-8">
            <p>
                Account registration is handled by your administrator or your
                organization's single sign-on. If you have an account,
                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">sign in here</a>.
                If you need an account, please contact your administrator.
            </p>
        </div>
    </div>
}

@if ((Model.ExternalLogins?.Count ?? 0) > 0)
{
    <hr />
    <h4>Sign in with your organization's identity provider</h4>
    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
        <div>
            @foreach (var provider in Model.ExternalLogins)
            {
                <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="Sign in with @provider.DisplayName">@provider.DisplayName</button>
            }
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
