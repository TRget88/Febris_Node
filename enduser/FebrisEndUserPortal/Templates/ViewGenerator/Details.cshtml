@:<div align="center">                   
    @:@@await Html.PartialAsync("@GetButtonPartial(Model.ViewDataTypeName)", new IndividualButtonPartial { /* Id = Model.PrimaryKey */ })
@:</div>
}
}
else
{
if (pkName != null)
{
@:<div align="center">                   
    @:@@await Html.PartialAsync("@GetButtonPartial(Model.ViewDataTypeName)", new IndividualButtonPartial { Id = "@@Model.@pkName" })
@:</div>            
}
else
{
@:<div align="center">                   
    @:@@await Html.PartialAsync("@GetButtonPartial(Model.ViewDataTypeName)", new IndividualButtonPartial { /* Id = Model.PrimaryKey */ })
@:</div>
}
}
