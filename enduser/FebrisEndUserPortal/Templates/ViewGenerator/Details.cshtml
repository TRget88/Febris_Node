<script src="~/lib/d3/d3.js"></script>
<script src="~/lib/billboard/billboard.js"></script>
<script src="~/lib/Widget/VariableSet.js"></script>
<script src="~/lib/PartialViewCalls/StatementTimeChartPartialViewCall.js"></script>
<script src="~/lib/PartialViewCalls/StatementCountChartPartialViewCall.js"></script>
