@inherits Microsoft.VisualStudio.Web.CodeGeneration.Templating.RazorTemplateBase
@using Microsoft.VisualStudio.Web.CodeGeneration.EntityFrameworkCore
@using System.Collections.Generic
@using System.Linq
@@model @Model.ViewDataTypeName
@{
    if (Model.IsPartialView)
    {    
@:@@using Febris.ModelLibrary.PartialViewModels;
@:@@using Febris.EnumLibrary;  
@:
@:<head>
    @:<meta name="viewport" content="width=device-width" />
    @:<link href="~/lib/billboard/billboard.css" rel="stylesheet" />
    @:<link href="~/css/Modal.css" rel="stylesheet" />
    @:<style>
        @:body {font-family: Arial, Helvetica, sans-serif;}
        @:.column {display: inline-block; padding: 5px;}
    @:</style>
@:</head>   
@:  
@:<div class="col-sm-12" align="center" ; style ="border-radius: 20px; padding:10px; align-items: center;">
    @:<div class="row" align="center" style="word-wrap: break-word; font-weight: bold; padding-top: 10px;">
        @:<h1 style="word-wrap: break-word; font-weight: bold;">@Model.ViewName</h1>
    @:</div>
@:</div>
    }
    else if (Model.IsLayoutPageSelected)
    {
@:@@using Febris.ModelLibrary.PartialViewModels;
@:@@using Febris.EnumLibrary;
@:
@:@@{
    @:ViewData["Title"] = "@Model.ViewName";
        if (!string.IsNullOrEmpty(Model.LayoutPageFile))
        {
    @:Layout = "@Model.LayoutPageFile";
        }
@:}
@:
@:<div class="col-sm-12" align="center" ; style = "border-radius: 20px; padding:10px; align-items: center;">
    @:<div class="row" align="center" style="word-wrap: break-word; font-weight: bold; padding-top: 10px;">
        @:<h1 style="word-wrap: break-word; font-weight: bold;">@Model.ViewName</h1>
    @:</div>
@:</div>
@:
    }
    else
    {
@:@@using Febris.ModelLibrary.PartialViewModels;
@:@@using Febris.EnumLibrary;
@:
@:@@{
    @:Layout = null;
@:}
@:
@:<!DOCTYPE html>
@:
@:<html>
@:<head>
    @:<meta name="viewport" content="width=device-width" />           
    @:<title>@Model.ViewName</title>
@:</head>
@:<body>
@:
//    PushIndent("    ");
    }
}
<br/>
@@await Html.PartialAsync("../Widgets/_StatusMessage", Model.FirstOrDefault().StatusMessage);
@{
    if (Model.IsPartialView)
    {
Dictionary<string, IPropertyMetadata> propertyLookup = ((IModelMetadata)Model.ModelMetadata).Properties.ToDictionary(x => x.PropertyName, x => x);
Dictionary<string, INavigationMetadata> navigationLookup = ((IModelMetadata)Model.ModelMetadata).Navigations.ToDictionary(x => x.AssociationPropertyName, x => x);

@:<div class="row">
    @:<div class="col-sm-6" align="center" ; style = "border-radius: 20px; padding:10px; align-items: center;">
        foreach (var item in Model.ModelMetadata.ModelType.GetProperties())
        {
            if (propertyLookup.TryGetValue(item.Name, out IPropertyMetadata property)
                && property.Scaffold && !property.IsForeignKey && !property.IsPrimaryKey)
            {       
        <div class="row">                 
            <div class = "col-sm-2" align="right">
                @@Html.DisplayNameFor(model => model.@GetValueExpression(property))
            </div>
            <div class = "col-sm-10" align="left">
                @@Html.DisplayFor(model => model.@GetValueExpression(property))
            </div>
        </div>
            }
            else if (navigationLookup.TryGetValue(item.Name, out INavigationMetadata navigation))
            {
        <div class="row">      
            <div class = "col-sm-2" align="right">
                @@Html.DisplayNameFor(model => model.@GetValueExpression(navigation))
            </div>
            <div class = "col-sm-10" align="left">
                @@Html.DisplayFor(model => model.@GetValueExpression(navigation).@navigation.DisplayPropertyName)
            </div>
        </div>
            }
        }	
    @:</div>
    @:<div class="col-sm-6" align="center" ; style = "border-radius: 20px; padding:10px; align-items: center;">
        @:@@if (Model.Image == "/images/DefaultMedia/default.png")
        @:{
            @:<img src="~/images/DefaultMedia/default.png" alt="Default image" width="128" height="128" />
        @:}
        @:else
        @:{
            @:<img src="@GetImagePartial()" alt="Image" width="128" height="128" />                    
        @:}
    @:</div>
@:</div>
	}
    else if (Model.IsLayoutPageSelected)
    {
@:<div>
    @:<h4>@Model.ViewDataTypeShortName</h4>
    @:<hr />

    Dictionary<string, IPropertyMetadata> propertyLookup = ((IModelMetadata)Model.ModelMetadata).Properties.ToDictionary(x => x.PropertyName, x => x);
    Dictionary<string, INavigationMetadata> navigationLookup = ((IModelMetadata)Model.ModelMetadata).Navigations.ToDictionary(x => x.AssociationPropertyName, x => x);


    @:<div class="row">
        @:<div class="col-sm-6" align="center" ; style = "border-radius: 20px; padding:10px; align-items: center;">
            foreach (var item in Model.ModelMetadata.ModelType.GetProperties())
            {
                if (propertyLookup.TryGetValue(item.Name, out IPropertyMetadata property)
                    && property.Scaffold && !property.IsForeignKey && !property.IsPrimaryKey)
                {       
            <div class="row">                 
                <div class = "col-sm-2" align="right">
                    @@Html.DisplayNameFor(model => model.@GetValueExpression(property))
                </div>
                <div class = "col-sm-10" align="left">
                    @@Html.DisplayFor(model => model.@GetValueExpression(property))
                </div>
            </div>
                }
                else if (navigationLookup.TryGetValue(item.Name, out INavigationMetadata navigation))
                {
            <div class="row">      
                <div class = "col-sm-2" align="right">
                    @@Html.DisplayNameFor(model => model.@GetValueExpression(navigation))
                </div>
                <div class = "col-sm-10" align="left">
                    @@Html.DisplayFor(model => model.@GetValueExpression(navigation).@navigation.DisplayPropertyName)
                </div>
            </div>
                }
            }	
        @:</div>
        @:<div class="col-sm-6" align="center" ; style = "border-radius: 20px; padding:10px; align-items: center;">
            @:@@if (Model.Image == "/images/DefaultMedia/default.png")
            @:{
                @:<img src="~/images/DefaultMedia/default.png" alt="Default image" width="128" height="128" />
            @:}
            @:else
            @:{
                @:<img src="@GetImagePartial()" alt="Image" width="128" height="128" />                    
            @:}
        @:</div>
    @:</div>
@:</div>
    }
    else
    {
@:<div>
    @:<h4>@Model.ViewDataTypeShortName</h4>
    @:<hr />
        
    Dictionary<string, IPropertyMetadata> propertyLookup = ((IModelMetadata)Model.ModelMetadata).Properties.ToDictionary(x => x.PropertyName, x => x);
    Dictionary<string, INavigationMetadata> navigationLookup = ((IModelMetadata)Model.ModelMetadata).Navigations.ToDictionary(x => x.AssociationPropertyName, x => x);

    @:<div class="row">
        @:<div class="col-sm-6" align="center" ; style = "border-radius: 20px; padding:10px; align-items: center;">
            foreach (var item in Model.ModelMetadata.ModelType.GetProperties())
            {
                if (propertyLookup.TryGetValue(item.Name, out IPropertyMetadata property)
                    && property.Scaffold && !property.IsForeignKey && !property.IsPrimaryKey)
                {       
            <div class="row">                 
                <div class = "col-sm-2" align="right">
                    @@Html.DisplayNameFor(model => model.@GetValueExpression(property))
                </div>
                <div class = "col-sm-10" align="left">
                    @@Html.DisplayFor(model => model.@GetValueExpression(property))
                </div>
            </div>
                }
                else if (navigationLookup.TryGetValue(item.Name, out INavigationMetadata navigation))
                {
            <div class="row">      
                <div class = "col-sm-2" align="right">
                    @@Html.DisplayNameFor(model => model.@GetValueExpression(navigation))
                </div>
                <div class = "col-sm-10" align="left">
                    @@Html.DisplayFor(model => model.@GetValueExpression(navigation).@navigation.DisplayPropertyName)
                </div>
            </div>
                }
            }	
        @:</div>
        @:<div class="col-sm-6" align="center" ; style = "border-radius: 20px; padding:10px; align-items: center;">
            @:@@if (Model.Image == "/images/DefaultMedia/default.png")
            @:{
                @:<img src="~/images/DefaultMedia/default.png" alt="Default image" width="128" height="128" />
            @:}
            @:else
            @:{
                @:<img src="@GetImagePartial()" alt="Image" width="128" height="128" />                    
            @:}
        @:</div>
    @:</div>
@:</div>
    }
}
<br/>
<div>
