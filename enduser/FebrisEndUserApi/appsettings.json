{
  "Transport": {
    "_comment": "Operator-configurable transport security for the API node host. Safe defaults preserve prior production behavior; a missing section keeps them. HSTS applies in non-Development only. Mirrors the Portal template so one policy configures both hosts.",
    "Hsts": {
      "Enabled": true,
      "MaxAgeDays": 365,
      "IncludeSubdomains": true,
      "Preload": false
    },
    "HttpsRedirection": false,
    "Cors": {
      "_comment": "Hostnames allowed cross-origin, e.g. 'app.example.com' (exact) or '.example.com' (domain + subdomains). Empty = same-origin + localhost only. List YOUR frontend host(s).",
      "AllowedHosts": [],
      "AllowCredentials": true
    },
    "SecurityHeaders": {
      "XContentTypeOptions": true,
      "XXssProtection": true,
      "XFrameOptions": "SameOrigin"
    }
  },
  "ConnectionStrings": {
    "UserDBConnection": "{UserDBConnectionString}",
    "DataDBConnection": "{DataDBConnectionString}",
    "XAPIDBConnection": "{XAPIDBConnectionString}",
    "AnalyticsDBConnection": "{AnalyticsDBConnectionString}"
  },
  "RedisConnectionStrings": {
    "AuthConnection": "localhost:6379",
    "HardwareConnection": "localhost:6379"
  },
  "SmbClient": {
    "Path": "{SmbClientPath}"
  },
  "FileSystem": {
    "UniqueFileSystemPath": "{UniqueFileSystemPath}\\"
  },
  "Serilog": {
    "Using": [],
    "MinimumLevel": {

      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }

    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.json",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "retainedFileCountLimit": "360"
        }
      }

    ]
  },
  "JwtSettings": {
    "Secret": "{JwtTokenSecret}",
    "ExpiryTimeInSeconds": "900",
    "RefreshTokenHours": "8"
  },
  "AppKeys": {
    "KeyRingPath": "keys"
  },
  "AllowedHosts": "*",
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    // EMPTY ON PURPOSE. AspNetCoreRateLimit reads this header with NO trust check, so any
    // caller could set it and land in a bucket of their choosing -- measured: 8 requests
    // with a rotating X-Real-IP were never limited, while the same 8 with it empty were.
    // The node was only safe behind the bundled proxy because Caddy OVERWRITES the header.
    // Empty makes the limiter fall back to Connection.RemoteIpAddress, which the
    // ForwardedHeaders middleware has already resolved using the operator-declared trusted
    // proxies. One trust boundary instead of three.
    //
    // IF YOU RUN BEHIND A PROXY you MUST declare it under "ForwardedHeaders" or every
    // caller collapses into one bucket and five requests lock login for everyone.
    "RealIpHeader": "",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "POST:/api/Token/authenticate",
        "Period": "15m",
        "Limit": 5
      },
      {
        "Endpoint": "POST:/api/Token",
        "Period": "15m",
        "Limit": 5
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 1200
      }
    ]
  }
}